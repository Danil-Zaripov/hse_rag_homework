# Формат API: anthropic (курсовой шлюз) или openai (OpenRouter и совместимые)
LLM_PROVIDER=anthropic

LLM_API_KEY=

LLM_BASE_URL=https://claude.gigaparsers.ru

LLM_MODEL=deepseek-flash

LLM_AUTH_SCHEME=x-api-key

# DeepSeek gateway limit: 10 requests/minute
LLM_RPM=10

# Course deepvk/USER-bge-m3 embedding service:
# 60 requests/minute, burst up to 20, at most 4 simultaneous requests
EMB_KEY=
EMB_URL=https://embeddings.parsers360.ru:10443

# --- Опциональный трейсинг в LangSmith (по умолчанию выключен) ---
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_AGENT_ID=hse-rag
# LANGSMITH_AGENT_ENVIRONMENT=local
